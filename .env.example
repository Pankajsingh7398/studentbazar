# ==============================================================================
# StudentBazaar Environment Configuration Example
# Copy this file to .env and provide your actual secrets.
# NEVER commit the real .env file into version control.
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=5000

# Client Application URL (for CORS and redirects)
FRONTEND_URL=http://localhost:8080

# MongoDB Atlas / Local Connection URI
MONGODB_URI=mongodb://localhost:27017/studentbazaar

# Authentication Secrets (Generate strong random 64-character strings)
JWT_SECRET=replace_with_a_secure_jwt_secret_min_32_characters_long
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_a_secure_refresh_secret_min_32_chars
COOKIE_SECRET=replace_with_a_secure_cookie_signing_secret

# Cloudinary Storage (For Product Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Payment Gateway (Test Mode Initially)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Transactional Email Notification (Optional / Nodemailer or SendGrid)
EMAIL_SERVICE=smtp
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_smtp_username
EMAIL_PASSWORD=your_smtp_password
EMAIL_FROM=support@studentbazaar.in

# Campus Delivery Configurations
CAMPUS_FREE_SHIPPING_THRESHOLD=200
STANDARD_SHIPPING_FEE=20
MAX_COD_AMOUNT=1500

# Admin Passkey (Configurable secret passkey for admin dashboard login)
ADMIN_PASSKEY=replace_with_your_admin_passkey

# WhatsApp Business Platform Cloud API
ADMIN_WHATSAPP_NUMBER=919876543210
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verification_token

